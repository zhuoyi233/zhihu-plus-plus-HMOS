model.onnx filter=lfs diff=lfs merge=lfs -text
tokenizer.json filter=lfs diff=lfs merge=lfs -text
*.aar filter=lfs diff=lfs merge=lfs -text

# 行尾归一：仓库内一律 LF，检出也是 LF（避免混合行尾破坏精确匹配与 diff）
* text=auto eol=lf

# 显式二进制，防止误转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.so binary
*.hap binary
*.cer binary
*.p7b binary
*.p12 binary
*.keystore binary
